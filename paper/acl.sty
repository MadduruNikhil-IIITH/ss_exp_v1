\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{acl}[2023/01/01 ACL Style Shim]

\RequirePackage[margin=1in, top=1in, bottom=1in, columnsep=0.25in]{geometry}
\RequirePackage{times}
\RequirePackage{latexsym}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}
\RequirePackage{hyperref}
\RequirePackage{fancyhdr}

% Title formatting
\def\@maketitle{%
  \newpage
  \null
  \vskip 2em%
  \begin{center}%
  \let \footnote \thanks
    {\LARGE \bf \@title \par}%
    \vskip 1.5em%
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
  \end{center}%
  \par
  \vskip 1.5em}

% Anonymous Header for review mode
\DeclareOption{review}{
  \pagestyle{fancy}
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \chead{\small \textit{Anonymous ACL submission}}
  \cfoot{\thepage}
  \renewcommand{\@author}{Anonymous ACL submission}
}

\ProcessOptions\relax
